# Copy to .env and adjust if needed. All scripts load this via python-dotenv.

# --- PostgreSQL (master/reference data) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=annapurna
POSTGRES_USER=annapurna
POSTGRES_PASSWORD=annapurna_dev_password

# --- MinIO (S3-compatible object store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=annapurna_minio
MINIO_SECRET_KEY=annapurna_minio_secret
MINIO_SECURE=false
MINIO_BUCKET=annapurna

# --- Source dataset location on disk (the ZIP contents you were given) ---
# Path is relative to the LAB-1/ directory unless absolute.
SOURCE_DATA_DIR=../data
